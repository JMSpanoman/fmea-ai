# Copy this file to ENV.local and set your values.
# ENV.local is gitignored; do not commit real keys.

# Required for AI features (Generate V&V from Risk, FMEA suggestions, etc.)
# Get a key at https://platform.openai.com/api-keys
# Backend also accepts OPENAI_KEY if your environment sets that.
# Same variable powers MAUDE narrative extraction for PMS / post-market reports (see postmarket.env.example).
OPENAI_API_KEY=sk-your-key-here

# Optional: openFDA — higher rate limits for MAUDE ingest + post-market pipeline / PMS MAUDE report
# OPENFDA_API_KEY=
# (Full list: fmea_backend/postmarket.env.example)

# Optional: database (defaults to sqlite in container if unset)
# DATABASE_URL=sqlite:///./fmea.db
