# Copy this file to ENV.local and set your values.
# ENV.local is gitignored; do not commit real keys.

# Required for AI features (Generate V&V from Risk, FMEA suggestions, etc.)
# Get a key at https://platform.openai.com/api-keys
# Backend also accepts OPENAI_KEY if your environment sets that.
OPENAI_API_KEY=sk-your-key-here

# Optional: database (defaults to sqlite in container if unset)
# DATABASE_URL=sqlite:///./fmea.db
