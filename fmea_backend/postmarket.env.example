# Post-market / PMS evidence stack (MAUDE ingest, NLP extraction, scoring, structured PMS/MAUDE report)
# Copy these lines into fmea_backend/ENV.local or fmea_backend/.env (gitignored).
#
# Used by:
#   - POST /postmarket/ingest, /extract, /run-pipeline
#   - POST /postmarket/report (structured report UI)
#   - RealWorldEvidencePanel / PostMarketReport frontend (same backend)
#
# The in-app "PMS Signal Feedback Report" (internal signals only) does NOT require these keys.

# Optional but recommended: higher openFDA rate limits (https://open.fda.gov/apis/authentication/)
OPENFDA_API_KEY=

# Default public API host (override only if proxying)
OPENFDA_BASE_URL=https://api.fda.gov

# Required for MAUDE narrative NLP extraction (services/postmarket_nlp.py) and any OpenAI-backed post-market steps
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional JSON override for services/risk_scoring.py (PostmarketRiskScoringConfig)
# POSTMARKET_RISK_SCORING_CONFIG_JSON={"outcome_weights":{"death":5,"injury":3,"malfunction":1,"other":1.5,"unknown":1.2},"probability_thresholds":{"min_weighted_for_2":3,"min_weighted_for_3":10,"min_weighted_for_4":25,"min_weighted_for_5":60}}
