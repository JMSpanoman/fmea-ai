#
# Local development environment variables (example)
#
# Create a file named `fmea_backend/ENV.local` (gitignored) and paste these keys there.
#

# Required for AI generation endpoints ("Generate with AI")
OPENAI_API_KEY=

# Optional: pick a model
# OPENAI_MODEL=gpt-4o-mini

# Optional: dev defaults
ENVIRONMENT=development
DATABASE_URL=sqlite:////tmp/smart_fmea_local.db
CORS_ORIGINS=http://localhost:5174,http://localhost:5173,http://localhost:4173

