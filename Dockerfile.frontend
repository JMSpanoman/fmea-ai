# Build stage
FROM node:18-alpine as build

WORKDIR /app

# Copy package files
COPY frontend/package*.json ./

# Clear npm cache and install dependencies
RUN npm cache clean --force
RUN npm install --no-audit --no-fund

# Copy source code
COPY frontend/ .

# Clean any existing build and ensure clean state
RUN rm -rf dist node_modules/.vite
RUN npm ci --no-audit --no-fund

# Verify installation and show debug info
RUN npm list --depth=0
RUN node -v && npm -v && node -p "require('./package-lock.json').lockfileVersion"

# Build the application
RUN npm run build

# Production stage
FROM nginx:alpine

# Copy built files from build stage
COPY --from=build /app/dist /usr/share/nginx/html

# Copy nginx configuration template
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf.template

# Copy startup script
COPY frontend/start-nginx.sh /start-nginx.sh
RUN chmod +x /start-nginx.sh

# Install envsubst
RUN apk add --no-cache gettext

# Expose port (Render will set PORT env var)
EXPOSE $PORT

# Start nginx with port substitution
CMD ["/start-nginx.sh"]
