# Production Environment Variables
# Copy this file to `.env.production` locally if needed. Do not commit secrets.
# Names only — set real values in the Render dashboard.

# Environment
ENVIRONMENT=production

# Database (kept on the Render disk mounted at /app/db; not exposed publicly)
DATABASE_URL=sqlite:////app/db/fmea.db

# Security (set in hosting provider; never commit real values)
JWT_SECRET_KEY=
SECRET_KEY=

# CORS — production frontend origins only (comma-separated, no wildcards)
CORS_ORIGINS=https://fmea-frontend.onrender.com,https://fmea-ai-frontend.onrender.com,https://demo.smartrisk.com

# Optional AI
OPENAI_API_KEY=

# Demo login (email allowlist; no passwords). Disabled unless ALLOW_DEV_LOGIN=true.
ALLOW_DEV_LOGIN=true
DEV_LOGIN_ALLOWED_EMAILS=gridmatrix@gridmatrix.com,john@fotonconsulting.com
DEMO_ENSURE_PROJECT=true
DEMO_REASSIGN_PROJECT=true
DEMO_PROJECT_ID=cd214464-e10b-488a-86dc-f24022508b60
DEMO_USER_EMAIL=gridmatrix@gridmatrix.com

# Logging
LOG_LEVEL=INFO

# Frontend (Render runtime). Leave VITE_API_BASE_URL unset so the SPA uses same-origin /api.
BACKEND_URL=https://fmea-backend.onrender.com
NODE_ENV=production

# MasterControl (optional; set in the host, never in git)
MC_BASE=
MC_TOKEN=
MC_CONNECTION_ID=
MC_RPN_CALCULATED=false
